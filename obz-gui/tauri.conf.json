{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qing-zip",
  "version": "0.10.1",
  "identifier": "dev.openarchive.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "qing-zip",
        "width": 1120,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
