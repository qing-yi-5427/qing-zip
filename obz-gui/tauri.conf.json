{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qing-zip",
  "version": "0.11.0",
  "identifier": "dev.openarchive.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "qing-zip",
        "width": 1120,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
